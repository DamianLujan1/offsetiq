# OffsetIQ environment variables (set in Vercel → Project → Settings → Environment Variables).
# None are required: without them the app runs in DEMO mode (mock sign-in, simulated checkout).

# Stripe (test or live). Leave unset for demo mode. NEVER commit real keys.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
# Recurring monthly per-seat Price id from your Stripe dashboard.
STRIPE_PRICE_ID=price_REPLACE_ME
# Public base URL used for Stripe success/cancel redirects.
NEXT_PUBLIC_APP_URL=https://your-deployment.vercel.app

# Screen mode: URL of the Python screening agent (python -m agent.server). The Next.js route
# /api/screen proxies to it, so it can stay private. In `next dev` it defaults to
# http://127.0.0.1:8765; in production Screen mode is off until this is set (Analyze is unaffected).
OFFSETIQ_AGENT_URL=http://127.0.0.1:8765
# Shared secret between /api/screen and the agent. Set the same value on both (the agent then
# rejects any caller without it). Leave unset for local development.
OFFSETIQ_AGENT_TOKEN=
